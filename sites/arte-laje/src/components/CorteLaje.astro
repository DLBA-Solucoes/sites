---
// Corte da laje em desenho técnico, montado a partir do texto da própria Arte Laje:
// capa de concreto, tela, nervura/treliça, vigota ou painel e enchimento (EPS ou lajota).
// O visitante troca o tipo de laje e o enchimento; o desenho e a legenda mudam juntos.
import { url } from '../lib/site';

interface Props {
  inicial?: 'trelicada' | 'mini-painel' | 'convencional';
  compacto?: boolean;
}
const { inicial = 'trelicada', compacto = false } = Astro.props;

const nervuras = [150, 450, 750, 1050];
const Y = { capaTopo: 60, capaBase: 130, enchBase: 290, baseFim: 322 };
const blocos = nervuras.slice(0, -1).map((c) => ({ x: c + 42, w: 216 }));
// Bordas: meio bloco antes da primeira e depois da última nervura.
const bordas = [
  { x: 0, w: nervuras[0] - 42 },
  { x: nervuras.at(-1)! + 42, w: 1200 - nervuras.at(-1)! - 42 },
];
const todosBlocos = [...bordas, ...blocos];

const TIPOS = {
  trelicada: {
    nome: 'Treliçada',
    vao: 'Vãos de até 12 m',
    nota: 'Suporta parede sobre a laje e grandes cargas. Uni ou bidirecional.',
    p3: 'Treliça de aço',
    p4: 'Vigota treliçada (sapata de concreto)',
  },
  'mini-painel': {
    nome: 'Mini painel',
    vao: 'Grandes vãos com menos peso',
    nota: 'Parte de baixo contínua e lisa: dispensa chapisco, emboço e reboco.',
    p3: 'Treliça de aço',
    p4: 'Painel contínuo de concreto',
  },
  convencional: {
    nome: 'Convencional',
    vao: 'Vãos de até 5 m',
    nota: 'A mais barata e rápida de montar. Para piso e forro, sem parede sobre a laje.',
    p3: 'Nervura de concreto',
    p4: 'Vigota em T invertido',
  },
} as const;
---

<figure class:list={['corte', compacto && 'compacto']} data-corte data-tipo={inicial} data-ench="eps">
  <div class="controles" role="group" aria-label="Monte a laje">
    <fieldset>
      <legend class="cota">Tipo de laje</legend>
      <div class="seg">
        {
          Object.entries(TIPOS).map(([k, v]) => (
            <label>
              <input type="radio" name="tipo" value={k} checked={k === inicial} />
              <span>{v.nome}</span>
            </label>
          ))
        }
      </div>
    </fieldset>
    <fieldset>
      <legend class="cota">Enchimento</legend>
      <div class="seg">
        <label><input type="radio" name="ench" value="eps" checked /><span>EPS (isopor)</span></label>
        <label data-so-lajota><input type="radio" name="ench" value="lajota" /><span>Lajota cerâmica</span></label>
      </div>
    </fieldset>
  </div>

  <div class="prancha folha">
    <svg viewBox="0 -10 1200 380" role="img" aria-labelledby="corte-titulo corte-desc" class="desenho">
      <title id="corte-titulo">Corte de uma laje pré-fabricada</title>
      <desc id="corte-desc">Camadas de cima para baixo: capa de concreto com tela, enchimento entre as nervuras, e vigotas ou painel embaixo.</desc>
      <defs>
        <pattern id="concreto" width="14" height="14" patternUnits="userSpaceOnUse">
          <rect width="14" height="14" fill="#cfccc3"></rect>
          <circle cx="3" cy="4" r="1" fill="#a9a59a"></circle>
          <circle cx="10" cy="9" r="1.2" fill="#b4b0a6"></circle>
          <circle cx="7" cy="12" r="0.7" fill="#9c988d"></circle>
        </pattern>
        <pattern id="eps" width="10" height="10" patternUnits="userSpaceOnUse">
          <rect width="10" height="10" fill="#fdfdfb"></rect>
          <circle cx="2.5" cy="2.5" r="1.6" fill="none" stroke="#e3e2dc" stroke-width="0.8"></circle>
          <circle cx="7.5" cy="7.5" r="1.6" fill="none" stroke="#e3e2dc" stroke-width="0.8"></circle>
        </pattern>
      </defs>

      <!-- capa de concreto -->
      <rect x="0" y={Y.capaTopo} width="1200" height={Y.capaBase - Y.capaTopo} fill="url(#concreto)"></rect>
      <line x1="0" x2="1200" y1="96" y2="96" class="tela"></line>
      {Array.from({ length: 24 }, (_, i) => <circle cx={25 + i * 50} cy="96" r="3.5" class="tela-no" />)}

      <!-- nervuras de concreto entre os blocos (todas as variantes) -->
      {nervuras.map((c) => <rect x={c - 42} y={Y.capaBase} width="84" height={Y.enchBase - Y.capaBase} fill="url(#concreto)" />)}

      <!-- enchimento: EPS -->
      <g class="v-eps">
        {todosBlocos.map((b) => <rect x={b.x} y={Y.capaBase} width={b.w} height={Y.enchBase - Y.capaBase} fill="url(#eps)" class="bloco" />)}
      </g>
      <!-- enchimento: lajota cerâmica (com furos) -->
      <g class="v-lajota">
        {
          todosBlocos.map((b) => (
            <g>
              <rect x={b.x} y={Y.capaBase} width={b.w} height={Y.enchBase - Y.capaBase} class="lajota" />
              {[0, 1].map((linha) =>
                Array.from({ length: Math.max(1, Math.floor((b.w - 16) / 52)) }, (_, i) => (
                  <rect x={b.x + 14 + i * 52} y={Y.capaBase + 22 + linha * 66} width="38" height="46" rx="4" class="furo" />
                )),
              )}
            </g>
          ))
        }
      </g>

      <!-- vigota em T invertido (convencional) -->
      <g class="v-convencional">
        {
          nervuras.map((c) => (
            <g>
              <rect x={c - 62} y={Y.enchBase} width="124" height={Y.baseFim - Y.enchBase} fill="url(#concreto)" class="peca-contorno" />
              <rect x={c - 18} y={Y.capaBase + 50} width="36" height={Y.enchBase - Y.capaBase - 50} fill="url(#concreto)" class="peca-contorno" />
              <circle cx={c - 34} cy={Y.enchBase + 16} r="5" class="aco" />
              <circle cx={c + 34} cy={Y.enchBase + 16} r="5" class="aco" />
            </g>
          ))
        }
      </g>
      <!-- vigota treliçada -->
      <g class="v-trelicada">
        {nervuras.map((c) => <rect x={c - 62} y={Y.enchBase} width="124" height={Y.baseFim - Y.enchBase} fill="url(#concreto)" class="peca-contorno" />)}
      </g>
      <!-- painel contínuo (mini painel) -->
      <g class="v-mini-painel">
        <rect x="0" y={Y.enchBase} width="1200" height={Y.baseFim - Y.enchBase} fill="url(#concreto)" class="peca-contorno"></rect>
      </g>
      <!-- treliça de aço (treliçada e mini painel) -->
      <g class="v-trelica">
        {
          nervuras.map((c) => (
            <g class="trelica">
              <polyline points={`${c - 30},${Y.enchBase + 14} ${c},${Y.capaBase + 18} ${c + 30},${Y.enchBase + 14}`} />
              <circle cx={c} cy={Y.capaBase + 18} r="6" class="aco" />
              <circle cx={c - 30} cy={Y.enchBase + 14} r="5" class="aco" />
              <circle cx={c + 30} cy={Y.enchBase + 14} r="5" class="aco" />
            </g>
          ))
        }
      </g>

      <!-- cotas -->
      <g class="cotas">
        <line x1="1180" x2="1180" y1={Y.capaTopo} y2={Y.baseFim}></line>
        <line x1="1170" x2="1190" y1={Y.capaTopo} y2={Y.capaTopo}></line>
        <line x1="1170" x2="1190" y1={Y.baseFim} y2={Y.baseFim}></line>
        <line x1={nervuras[1]} x2={nervuras[2]} y1="352" y2="352"></line>
        <line x1={nervuras[1]} x2={nervuras[1]} y1="342" y2="362"></line>
        <line x1={nervuras[2]} x2={nervuras[2]} y1="342" y2="362"></line>
        <text x={(nervuras[1] + nervuras[2]) / 2} y="344" text-anchor="middle">entre-eixo</text>
      </g>

      <!-- marcadores das peças -->
      <g class="marcas">
        {
          [
            { n: 1, x: 300, y: 78 },
            { n: 2, x: 850, y: 96 },
            { n: 3, x: nervuras[1], y: 196 },
            { n: 4, x: nervuras[2], y: 306 },
            { n: 5, x: 600, y: 210 },
          ].map((m) => (
            <g class="marca" transform={`translate(${m.x} ${m.y})`}>
              <circle r="15" />
              <text dy="5" text-anchor="middle">{m.n}</text>
            </g>
          ))
        }
      </g>
    </svg>

    <div class="legenda">
      <ol class="pecas">
        <li><span class="peca">1</span>Capa de concreto</li>
        <li><span class="peca">2</span>Tela de laje</li>
        {
          Object.entries(TIPOS).map(([k, v]) => (
            <li data-para={k}>
              <span class="peca">3</span>
              {v.p3}
            </li>
          ))
        }
        {
          Object.entries(TIPOS).map(([k, v]) => (
            <li data-para={k}>
              <span class="peca">4</span>
              {v.p4}
            </li>
          ))
        }
        <li><span class="peca">5</span>Enchimento:&nbsp;<span data-nome-ench>EPS (isopor)</span></li>
      </ol>
      <div class="ficha">
        {
          Object.entries(TIPOS).map(([k, v]) => (
            <div data-para={k} class="ficha-tipo">
              <p class="vao num">{v.vao}</p>
              <p class="text-grafite-2">{v.nota}</p>
              <a href={url('lajes', k)} class="mt-3 inline-flex items-center gap-1 font-bold text-azul">
                Ver a laje {v.nome.toLowerCase()} →
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </div>
  <figcaption class="sr-only">Desenho esquemático, fora de escala, feito a partir das descrições técnicas da Arte Laje.</figcaption>
</figure>

<style>
  .controles {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-bottom: 1rem;
  }
  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
  }
  legend {
    margin-bottom: 0.4rem;
  }
  .seg {
    display: inline-flex;
    border: 1.5px solid var(--color-grafite);
    border-radius: 2px;
    background: var(--color-papel);
  }
  .seg label {
    position: relative;
  }
  .seg input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }
  .seg span {
    display: grid;
    place-items: center;
    min-height: 44px;
    padding: 0 1rem;
    font-weight: 750;
    font-size: 0.9688rem;
    white-space: nowrap;
    transition:
      background-color 160ms var(--ease-out),
      color 160ms var(--ease-out);
  }
  .seg label + label span {
    border-left: 1.5px solid var(--color-grafite);
  }
  .seg input:checked + span {
    background: var(--color-grafite);
    color: var(--color-papel);
  }
  .seg input:focus-visible + span {
    outline: 3px solid var(--color-azul);
    outline-offset: 2px;
  }
  .seg input:disabled + span {
    color: var(--color-cimento);
    cursor: not-allowed;
  }
  .prancha {
    padding: clamp(0.75rem, 2vw, 1.5rem);
    border: 1px solid var(--color-cimento);
    position: relative;
  }
  .desenho {
    width: 100%;
    height: auto;
    display: block;
  }
  .desenho :global(.peca-contorno) {
    stroke: var(--color-grafite);
    stroke-width: 1.5;
  }
  .desenho :global(.bloco) {
    stroke: #b9b7ae;
    stroke-width: 1.5;
  }
  .desenho :global(.lajota) {
    fill: #d98b4f;
    stroke: #9f5a27;
    stroke-width: 1.5;
  }
  .desenho :global(.furo) {
    fill: #f4d7bd;
    stroke: #9f5a27;
    stroke-width: 1.2;
  }
  .desenho :global(.aco) {
    fill: #5a6068;
    stroke: var(--color-grafite);
    stroke-width: 1;
  }
  .desenho :global(.trelica polyline) {
    fill: none;
    stroke: #5a6068;
    stroke-width: 4;
    stroke-linejoin: round;
  }
  .desenho .tela {
    stroke: #6b7078;
    stroke-width: 2;
    stroke-dasharray: 2 0;
  }
  .desenho :global(.tela-no) {
    fill: #6b7078;
  }
  .cotas line {
    stroke: var(--color-azul);
    stroke-width: 1.5;
  }
  .cotas text {
    fill: var(--color-azul);
    font: 700 15px var(--font-sans);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .marca circle {
    fill: var(--color-papel);
    stroke: var(--color-azul);
    stroke-width: 2.5;
  }
  .marca text {
    fill: var(--color-azul);
    font: 800 15px var(--font-sans);
  }

  /* Variantes: o que aparece em cada combinação. */
  .v-eps,
  .v-lajota,
  .v-convencional,
  .v-trelicada,
  .v-mini-painel,
  .v-trelica {
    transition:
      opacity 320ms var(--ease-out),
      transform 420ms var(--ease-out);
  }
  .corte:not([data-ench='eps']) .v-eps,
  .corte:not([data-ench='lajota']) .v-lajota,
  .corte:not([data-tipo='convencional']) .v-convencional,
  .corte:not([data-tipo='trelicada']) .v-trelicada,
  .corte:not([data-tipo='mini-painel']) .v-mini-painel,
  .corte[data-tipo='convencional'] .v-trelica {
    opacity: 0;
    transform: translateY(-14px);
  }
  .corte:not([data-tipo='trelicada']) [data-para='trelicada'],
  .corte:not([data-tipo='mini-painel']) [data-para='mini-painel'],
  .corte:not([data-tipo='convencional']) [data-para='convencional'] {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .v-eps,
    .v-lajota,
    .v-convencional,
    .v-trelicada,
    .v-mini-painel,
    .v-trelica {
      transition: none;
    }
  }

  .legenda {
    display: grid;
    gap: 1rem 2rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-cimento);
  }
  .pecas {
    display: grid;
    gap: 0.45rem;
    font-size: 0.9688rem;
    font-weight: 600;
  }
  .pecas li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .vao {
    font-size: 1.5rem;
    font-weight: 850;
    letter-spacing: -0.02em;
    color: var(--color-azul);
  }
  .ficha-tipo a {
    text-decoration: none;
  }
  .ficha-tipo a:hover {
    text-decoration: underline;
  }
  @media (min-width: 720px) {
    .legenda {
      grid-template-columns: 1fr 1fr;
    }
  }
  .compacto .legenda {
    grid-template-columns: 1fr;
  }
  @media (min-width: 1100px) {
    .compacto .legenda {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

<script>
  for (const raiz of document.querySelectorAll<HTMLElement>('[data-corte]')) {
    const nomeEnch = raiz.querySelector<HTMLElement>('[data-nome-ench]')!;
    const lajota = raiz.querySelector<HTMLInputElement>('[data-so-lajota] input')!;
    const eps = raiz.querySelector<HTMLInputElement>('input[name=ench][value=eps]')!;
    const atualizar = () => {
      const tipo = raiz.querySelector<HTMLInputElement>('input[name=tipo]:checked')!.value;
      // Mini painel só existe com EPS.
      lajota.disabled = tipo === 'mini-painel';
      if (lajota.disabled && lajota.checked) eps.checked = true;
      const ench = raiz.querySelector<HTMLInputElement>('input[name=ench]:checked')!.value;
      raiz.dataset.tipo = tipo;
      raiz.dataset.ench = ench;
      nomeEnch.textContent = ench === 'eps' ? 'EPS (isopor)' : 'Lajota cerâmica';
    };
    raiz.addEventListener('change', atualizar);
    atualizar();
  }
</script>
