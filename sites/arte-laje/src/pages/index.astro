---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CorteLaje from '../components/CorteLaje.astro';
import Vendas from '../components/Vendas.astro';
import Icone from '../components/Icone.astro';
import { foto, url } from '../lib/site';
import { EMPRESA, FABRICA, FROTA, LAJES, OBRAS, SERVICOS } from '../data/conteudo';

const etapas = [0, 5, 6, 10, 12, 18].map((i) => ({ ...FABRICA[i], n: i + 1 }));
---

<Base
  titulo="Arte Laje · Lajes pré-fabricadas em Jaraguá do Sul desde 1977"
  descricao="Lajes treliçadas, mini painel e convencionais fabricadas em Jaraguá do Sul desde 1977, com engenheiro, ART e esquema de montagem. Mande seu projeto."
>
  <section class="abertura" aria-labelledby="titulo">
    <div class="wrap grid gap-10 pt-[clamp(2rem,5vw,4rem)] pb-[clamp(3rem,6vw,5rem)] lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-5">
        <h1 id="titulo" class="h-display entra text-[clamp(3rem,1.8rem+5vw,5.75rem)]">
          Nosso negócio é <span class="text-azul">concreto.</span>
        </h1>
        <p class="lead entra mt-6 text-grafite-2" style="--i:1">
          Lajes treliçadas, mini painel e convencionais, fabricadas no Nova Brasília desde 1977. Com engenheiro civil, ART e o esquema de montagem entregue junto com a laje.
        </p>
        <div class="entra mt-8 flex flex-wrap gap-3" style="--i:2">
          <a href={url('contato')} class="btn btn-laranja">Enviar projeto para orçamento <Icone nome="seta" /></a>
          <a href={`tel:${EMPRESA.telefone.link}`} class="btn btn-linha num"><Icone nome="telefone" />{EMPRESA.telefone.numero}</a>
        </div>
      </div>
      <div class="entra lg:col-span-7" style="--i:2">
        <CorteLaje compacto />
      </div>
    </div>
  </section>

  <section class="border-t border-cimento py-[clamp(4rem,8vw,7rem)]" aria-labelledby="lajes-titulo">
    <div class="wrap">
      <h2 id="lajes-titulo" class="h-display max-w-[16ch] text-[clamp(2.5rem,1.6rem+3.6vw,4.5rem)]">Três lajes, cada uma para um tipo de obra</h2>
      <ol class="lajes mt-12">
        {
          LAJES.map((l, i) => (
            <li>
              <a href={url('lajes', l.slug)} class="laje">
                <span class="peca num">{i + 1}</span>
                <span class="laje-texto">
                  <span class="block text-[clamp(1.6rem,1.2rem+1.4vw,2.25rem)] font-extrabold tracking-tight">{l.nome}</span>
                  <span class="cota mt-1 block">{l.subtitulo} · {l.vao}</span>
                  <span class="mt-3 block max-w-[52ch] text-grafite-2">{l.resumo}</span>
                </span>
                <span class="laje-foto">
                  <Image src={foto(l.fotos[0])} alt="" widths={[320, 640]} sizes="(min-width: 900px) 320px, 100vw" loading="lazy" />
                </span>
                <Icone nome="seta" class="laje-seta" />
              </a>
            </li>
          ))
        }
      </ol>
      <a href={url('acessorios')} class="mt-8 inline-flex items-center gap-2 font-bold text-azul no-underline hover:underline">
        Enchimentos e acessórios: EPS, lajota, caixa de luz, tela, canaleta <Icone nome="seta" class="size-4" />
      </a>
    </div>
  </section>

  <section class="fabrica bg-grafite py-[clamp(4rem,8vw,7rem)] text-papel" aria-labelledby="fabrica-titulo">
    <div class="wrap">
      <div class="grid gap-6 lg:grid-cols-2 lg:items-end">
        <h2 id="fabrica-titulo" class="h-display text-[clamp(2.5rem,1.6rem+3.6vw,4.5rem)]">Do projeto à laje pronta, na nossa fábrica</h2>
        <p class="lead text-cimento">
          O projeto é analisado e dimensionado, a ferragem é cortada para cada obra e o concreto é misturado e lançado à máquina. São 20 etapas registradas; estas são seis delas.
        </p>
      </div>
      <ol class="etapas mt-12">
        {
          etapas.map((e) => (
            <li>
              <figure>
                <Image src={foto(e.foto)} alt={e.legenda} widths={[400, 565]} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw" loading="lazy" />
                <figcaption>
                  <span class="num text-laranja">{String(e.n).padStart(2, '0')}</span>
                  {e.legenda}
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ol>
      <a href={url('empresa')} class="btn mt-10 bg-papel text-grafite hover:bg-white">Ver as 20 etapas da fábrica <Icone nome="seta" /></a>
    </div>
  </section>

  <section class="py-[clamp(4rem,8vw,7rem)]" aria-labelledby="servicos-titulo">
    <div class="wrap grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 id="servicos-titulo" class="h-display text-[clamp(2.5rem,1.6rem+3.6vw,4.5rem)]">A laje chega com projeto e responsável técnico</h2>
        <figure class="frota mt-10">
          <Image src={foto(FROTA[1])} alt="Caminhões com guindaste da Arte Laje" widths={[480, 800]} sizes="(min-width: 1024px) 38vw, 100vw" loading="lazy" />
          <figcaption class="cota mt-2">Frota própria com guindaste</figcaption>
        </figure>
      </div>
      <ol class="servicos lg:col-span-6 lg:col-start-7">
        {
          SERVICOS.map((s, i) => (
            <li>
              <span class="peca num">{i + 1}</span>
              <div>
                <h3 class="text-xl font-extrabold tracking-tight">{s.titulo}</h3>
                <p class="mt-1 text-grafite-2">{s.texto}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="border-y border-cimento bg-concreto-2 py-[clamp(4rem,8vw,7rem)]" aria-labelledby="obras-titulo">
    <div class="wrap mb-10 flex flex-wrap items-end justify-between gap-6">
      <h2 id="obras-titulo" class="h-display text-[clamp(2.5rem,1.6rem+3.6vw,4.5rem)]">Obras na região</h2>
      <a href={url('obras')} class="btn btn-linha">Ver todas as obras <Icone nome="seta" /></a>
    </div>
    <div class="obras" tabindex="0" role="region" aria-labelledby="obras-titulo">
      <ul>
        {
          OBRAS.slice(0, 10).map((o) => (
            <li>
              <Image src={foto(o)} alt="Obra na região de Jaraguá do Sul" widths={[300, 460]} sizes="300px" loading="lazy" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Vendas />
</Base>

<style>
  .lajes {
    border-top: 2px solid var(--color-grafite);
  }
  .lajes > li {
    border-bottom: 1px solid var(--color-cimento);
  }
  .laje {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem 1.5rem;
    padding: 1.75rem 0;
    text-decoration: none;
    align-items: start;
  }
  .laje-foto {
    grid-column: 1 / -1;
    overflow: hidden;
  }
  .laje-foto :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform 600ms var(--ease-out);
  }
  .laje :global(.laje-seta) {
    width: 1.75rem;
    height: 1.75rem;
    color: var(--color-azul);
    grid-row: 1;
    grid-column: 3;
    transition: transform 300ms var(--ease-out);
  }
  @media (hover: hover) {
    .laje:hover :global(.laje-seta) {
      transform: translateX(5px);
    }
    .laje:hover .laje-foto :global(img) {
      transform: scale(1.04);
    }
  }
  @media (min-width: 900px) {
    .laje {
      grid-template-columns: auto 1fr 320px auto;
      align-items: center;
      gap: 2rem;
    }
    .laje-foto {
      grid-column: 3;
    }
    .laje :global(.laje-seta) {
      grid-column: 4;
      grid-row: 1;
    }
  }
  .etapas {
    display: grid;
    gap: 2rem 1.25rem;
  }
  @media (min-width: 640px) {
    .etapas {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .etapas {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .etapas figure {
    margin: 0;
  }
  .etapas :global(img) {
    width: 100%;
    aspect-ratio: 565 / 334;
    object-fit: cover;
  }
  .etapas figcaption {
    display: flex;
    gap: 0.75rem;
    padding-top: 0.75rem;
    font-weight: 600;
    border-top: 1px solid rgb(255 255 255 / 0.15);
    margin-top: 0.75rem;
  }
  .etapas figcaption span {
    font-weight: 800;
  }
  .frota {
    margin: 0;
  }
  .frota :global(img) {
    width: 100%;
  }
  .servicos {
    display: grid;
    gap: 0;
    border-top: 2px solid var(--color-grafite);
  }
  .servicos > li {
    display: flex;
    gap: 1rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--color-cimento);
  }
  .obras {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 1rem;
  }
  .obras ul {
    display: flex;
    gap: 10px;
    padding-inline: var(--gutter);
    width: max-content;
  }
  .obras li {
    scroll-snap-align: start;
    scroll-margin-inline: var(--gutter);
  }
  .obras :global(img) {
    height: clamp(260px, 32vw, 360px);
    width: auto;
  }
</style>
