---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Vendas from '../components/Vendas.astro';
import { foto } from '../lib/site';
import { ACESSORIOS } from '../data/conteudo';
---

<Base titulo="Enchimentos e acessórios" descricao="EPS, lajota cerâmica, caixa de luz concretada, tela, canaletas, eletroduto e haste metálica para lajes." ativo="acessorios">
  <header class="wrap pt-[clamp(2.5rem,6vw,5rem)] pb-10">
    <h1 class="h-display entra max-w-[16ch] text-[clamp(3rem,1.8rem+5vw,5.5rem)]">Enchimentos e acessórios</h1>
    <p class="lead entra mt-5 text-grafite-2" style="--i:1">Tudo o que vai junto com a laje, do enchimento à fixação do telhado.</p>
  </header>
  <section class="wrap pb-[clamp(4rem,8vw,7rem)]" aria-label="Lista de acessórios">
    <ol class="itens">
      {
        ACESSORIOS.map((a, i) => (
          <li>
            <span class="foto">
              <Image src={foto(a.foto)} alt={a.nome} widths={[280, 570]} sizes="(min-width: 768px) 280px, 40vw" loading="lazy" />
            </span>
            <span class="peca num">{i + 1}</span>
            <div>
              <h2 class="text-xl font-extrabold tracking-tight">{a.nome}</h2>
              <p class="mt-1 max-w-[52ch] text-grafite-2">{a.texto}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>
  <div class="border-t border-cimento"><Vendas /></div>
</Base>

<style>
  .itens {
    border-top: 2px solid var(--color-grafite);
  }
  .itens li {
    display: grid;
    grid-template-columns: 7.5rem auto 1fr;
    gap: 1rem;
    align-items: center;
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-cimento);
  }
  .foto {
    background: #ececea;
  }
  .foto :global(img) {
    width: 100%;
    aspect-ratio: 570 / 338;
    object-fit: cover;
    mix-blend-mode: multiply;
  }
  @media (min-width: 768px) {
    .itens li {
      grid-template-columns: 14rem auto 1fr;
      gap: 2rem;
    }
  }
</style>
