---
import Base from '../layouts/Base.astro';
import Vendas from '../components/Vendas.astro';
import Icone from '../components/Icone.astro';
import { EMPRESA } from '../data/conteudo';
---

<Base titulo="Contato e orçamento" descricao="Mande o projeto da sua obra para orçamento ou fale com a equipe de vendas da Arte Laje." ativo="contato">
  <Vendas nivel="h1" />
  <section class="border-t border-cimento py-[clamp(3rem,6vw,5rem)]" aria-labelledby="fabrica-end">
    <div class="wrap grid gap-6 md:grid-cols-12 md:items-end">
      <div class="md:col-span-7">
        <h2 id="fabrica-end" class="h-secao text-3xl">Fábrica e escritório</h2>
        <p class="mt-3 text-lg">{EMPRESA.endereco}</p>
        <p class="mt-1 text-grafite-2">Atendemos: {EMPRESA.regiao}.</p>
      </div>
      <div class="flex flex-wrap gap-3 md:col-span-5 md:justify-end">
        <a href={EMPRESA.mapa} target="_blank" rel="noopener" class="btn btn-azul"><Icone nome="mapa" />Como chegar</a>
      </div>
    </div>
  </section>
</Base>
