---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CorteLaje from '../../components/CorteLaje.astro';
import Vendas from '../../components/Vendas.astro';
import Icone from '../../components/Icone.astro';
import { foto, url } from '../../lib/site';
import { LAJES, type Laje } from '../../data/conteudo';

export function getStaticPaths() {
  return LAJES.map((l) => ({ params: { slug: l.slug }, props: { laje: l } }));
}
const { laje } = Astro.props as { laje: Laje };
const outras = LAJES.filter((l) => l !== laje);
---

<Base titulo={`${laje.nome} · ${laje.subtitulo}`} descricao={laje.resumo} ativo="lajes" og={laje.fotos[0]}>
  <nav class="wrap pt-6 text-sm text-grafite-2" aria-label="Breadcrumb">
    <a href={url('lajes')}>Lajes</a> / <span aria-current="page" class="font-bold text-grafite">{laje.nome}</span>
  </nav>
  <header class="wrap grid gap-8 pt-6 pb-12 lg:grid-cols-12 lg:items-end">
    <div class="lg:col-span-7">
      <h1 class="h-display entra text-[clamp(3rem,1.8rem+5vw,5.5rem)]">{laje.nome}</h1>
      <p class="entra mt-3 text-[clamp(1.25rem,1rem+1vw,1.75rem)] font-bold text-azul" style="--i:1">{laje.subtitulo} · {laje.vao}</p>
    </div>
    <p class="lead entra text-grafite-2 lg:col-span-5" style="--i:2">{laje.resumo}</p>
  </header>

  <section class="wrap pb-[clamp(3rem,6vw,5rem)]" aria-label="Corte da laje">
    <CorteLaje inicial={laje.slug} />
  </section>

  <section class="border-t border-cimento py-[clamp(3.5rem,7vw,6rem)]">
    <div class="wrap grid gap-12 lg:grid-cols-12">
      <div class="prosa lg:col-span-5">
        {laje.texto.map((p) => <p class="text-lg">{p}</p>)}
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <h2 class="h-secao text-3xl">Vantagens</h2>
        <ol class="vantagens mt-5">
          {
            laje.vantagens.map((v, i) => (
              <li>
                <span class="peca num">{i + 1}</span>
                {v}
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="bg-concreto-2 py-[clamp(3rem,6vw,5rem)]" aria-label="Fotos">
    <ul class="wrap fotos">
      {
        laje.fotos.map((f) => (
          <li>
            <Image src={foto(f)} alt={laje.nome} widths={[400, 800]} sizes="(min-width: 900px) 45vw, 100vw" loading="lazy" />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap py-[clamp(3rem,6vw,5rem)]" aria-labelledby="outras">
    <h2 id="outras" class="h-secao text-3xl">Outras lajes</h2>
    <ul class="mt-5 flex flex-wrap gap-3">
      {
        outras.map((o) => (
          <li>
            <a href={url('lajes', o.slug)} class="btn btn-linha">
              {o.nome}
              <Icone nome="seta" />
            </a>
          </li>
        ))
      }
      <li><a href={url('acessorios')} class="btn btn-linha">Acessórios <Icone nome="seta" /></a></li>
    </ul>
  </section>

  <div class="border-t border-cimento"><Vendas /></div>
</Base>

<style>
  .vantagens {
    display: grid;
    border-top: 2px solid var(--color-grafite);
  }
  .vantagens li {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--color-cimento);
    font-weight: 600;
  }
  .fotos {
    display: grid;
    gap: 12px;
  }
  @media (min-width: 900px) {
    .fotos {
      grid-template-columns: 1fr 1fr;
    }
  }
  .fotos :global(img) {
    width: 100%;
    aspect-ratio: 800 / 548;
    object-fit: cover;
  }
</style>
