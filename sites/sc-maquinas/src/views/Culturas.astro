---
import Base from '../layouts/Base.astro';
import CabecalhoPagina from '../components/CabecalhoPagina.astro';
import FaixaCampo from '../components/FaixaCampo.astro';
import { secao, t, type Lang } from '../lib/i18n';
import { culturas } from '../lib/dados';

interface Props {
  lang: Lang;
  alternativas: Partial<Record<Lang, string>>;
}
const { lang, alternativas } = Astro.props;
const ui = t(lang);
const lista = culturas(lang);
// Agrupa por letra inicial, como o índice remissivo de um catálogo.
const letras = new Map<string, typeof lista>();
for (const c of lista) {
  const l = c.nome.normalize('NFD')[0].toUpperCase();
  letras.set(l, [...(letras.get(l) ?? []), c]);
}
---

<Base lang={lang} titulo={ui.culturasTitulo} descricao={ui.culturasLead} alternativas={alternativas} secaoAtiva="culturas">
  <CabecalhoPagina titulo={ui.culturasTitulo} lead={ui.culturasLead} />
  <section class="wrap pb-[clamp(4rem,8vw,7rem)]" aria-label={ui.culturasTitulo}>
    <div class="indice">
      {
        [...letras].map(([letra, itens]) => (
          <div class="letra">
            <p class="display text-5xl text-sinal-vivo" aria-hidden="true">
              {letra}
            </p>
            <ul>
              {itens.map((c) => (
                <li>
                  <a href={secao(lang, 'culturas', c.slug)} class="item">
                    <span class="font-bold">{c.nome}</span>
                    <span class="num text-nevoa">{ui.busca.resultado(c.maquinas.length)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
  <section class="border-t regra bg-palco-2 py-[clamp(3rem,6vw,5rem)]" aria-labelledby="campo-titulo">
    <h2 id="campo-titulo" class="wrap display mb-8 text-[clamp(2.25rem,1.4rem+3.5vw,4.5rem)]">{ui.campoTitulo}</h2>
    <FaixaCampo lang={lang} />
  </section>
</Base>

<style>
  .indice {
    columns: 1;
    column-gap: 3rem;
    border-top: 2px solid var(--color-papel);
  }
  @media (min-width: 640px) {
    .indice {
      columns: 2;
    }
  }
  @media (min-width: 1024px) {
    .indice {
      columns: 3;
    }
  }
  .letra {
    break-inside: avoid;
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    padding-top: 1.25rem;
  }
  .letra p {
    line-height: 1;
  }
  .item {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--color-aco);
    text-decoration: none;
  }
  .item:hover span:first-child {
    color: var(--color-sinal-vivo);
  }
</style>
